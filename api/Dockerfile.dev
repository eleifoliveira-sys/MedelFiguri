FROM node:22-alpine AS swagger-assets

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM dunglas/frankenphp:1-php8.4-bookworm

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN install-php-extensions pdo_mysql zip bcmath opcache \
    && mkdir -p /data/caddy /config/caddy

WORKDIR /app

COPY docker/backend/Caddyfile /etc/caddy/Caddyfile
COPY --from=swagger-assets /workspace/node_modules/swagger-ui-dist /opt/swagger-ui
COPY composer.json composer.lock ./

COPY . .

# Development image: retains PHPUnit and other Composer development tools.
RUN composer validate --no-check-publish \
    && composer install --no-interaction --prefer-dist --no-scripts

RUN composer dump-autoload --no-interaction \
    && composer check-platform-reqs \
    && php artisan storage:link

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]